{
  "id": "workbench-guardrails",
  "name": "Workbench Guardrails",
  "description": "Safety profiles, native approvals, and a redacted SQLite-backed execution journal.",
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "trustedToolPolicies": ["workbench-guardrails"],
    "agentToolResultMiddleware": ["openclaw", "codex"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "profile": {
        "type": "string",
        "enum": ["personal-safe", "coding", "research-only", "high-autonomy"],
        "default": "personal-safe"
      },
      "approvalTtlMinutes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10080,
        "default": 60
      },
      "rules": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome"],
          "properties": {
            "outcome": { "type": "string", "enum": ["allow", "ask", "block"] },
            "tools": { "type": "array", "items": { "type": "string" } },
            "effects": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["read", "write", "execute", "send", "publish", "delete", "unknown"]
              }
            },
            "targetPrefix": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "reason": { "type": "string" }
          }
        }
      }
    }
  },
  "uiHints": {
    "profile": {
      "label": "Safety profile",
      "help": "Choose the default balance between autonomy and approval prompts."
    },
    "approvalTtlMinutes": {
      "label": "Approval expiry (minutes)",
      "help": "Unresolved approval requests deny the action after this interval."
    },
    "rules": {
      "label": "Policy overrides",
      "help": "The first matching rule refines the selected profile; unknown, delete, and publish safety floors remain."
    }
  }
}
